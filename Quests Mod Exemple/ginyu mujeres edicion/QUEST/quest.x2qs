TextEntry TMQ_TPQ_GYF_0
{
	en: "¡El Cambio de Cuerpo Extremo!"
}
TextEntry TMQ_TPQ_GYF_1
{
	en: "-Derrota a todos los Ginyu"
}
TextEntry TMQ_TPQ_GYF_2
{
	en: "-Salud del equipo agotada\n-Se acaba el tiempo"
}
TextEntry TMQ_TPQ_GYF_3
{
	en: "¡Ginyu ha tomado los cuerpos de varias guerreras! Derrótalos a todos y restaura la línea temporal."
}
TextEntry TMQ_TPQ_GYF_4
{
	en: "-Derrota a Ginyu (Vados) rápidamente"
}
TextEntry TMQ_TPQ_GYF_5
{
	en: "-Derrota a todos los enemigos"
}

