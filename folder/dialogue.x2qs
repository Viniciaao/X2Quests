Dialogue Dialogue9
{
	i28: 0

	DialoguePart
	{
		actor: "XBL" ; Perdição do Futuro
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_00_XBL" ; Nrgh... Raaaaagh!
		i8: 0
	}

	DialoguePart
	{
		actor: "TOK" ; Kaiohshin do Tempo
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_01_TOK" ; It's working! It's actually working!
		i8: 1
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_02_XBM" ; No... not quite yet.
		i8: 0
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_03_XBM" ; I'm willing to bet that it still has enough energy to regenerate the crystals.
		i8: 0
	}

}

Dialogue Dialogue10
{
	i28: 0

	DialoguePart
	{
		actor: "TOK" ; Kaiohshin do Tempo
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_10_TOK" ; Agh?! W-We're almost out of time.
		i8: 1
	}

	DialoguePart
	{
		actor: "TRX" ; Trunks
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_11_TRX" ; Supreme Kai of Time?! Wha...? My legs! They're turning transparent!
		i8: 1
	}

	DialoguePart
	{
		actor: "TRX" ; Trunks
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_12_TRX" ; Everyone... can you hear me? I'm sorry to say... but we're reaching our limits here.
		i8: 1
	}

	DialoguePart
	{
		actor: "TRX" ; Trunks
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_13_TRX" ; We've been protecting the Time Vault from the threat of the black hole, but that won't last much longer.
		i8: 1
	}

	DialoguePart
	{
		actor: "TRX" ; Trunks
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_14_TRX" ; After everything we've been through, our time has come... Pretty soon, we'll be gone...
		i8: 1
	}

}

Dialogue Dialogue11
{
	i28: 0

	DialoguePart
	{
		actor: "TRX" ; Trunks
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_17_TRX" ; Fu... you've changed. You aren't driven by dark ambitions anymore... What motivates you now is a strong conviction to protect!
		i8: 1
	}

	DialoguePart
	{
		actor: "TOK" ; Kaiohshin do Tempo
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_18_TOK" ; Remember what everyone said! They—all of us—have entrusted the future to you!
		i8: 1
	}

	DialoguePart
	{
		actor: "TOK" ; Kaiohshin do Tempo
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_19_TOK" ; We believe in you! Now have faith... and show us... just how strong you've become!
		i8: 1
	}

	DialoguePart
	{
		actor: "TRX" ; Trunks
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_20_TRX" ; History...
		i8: 1
	}

	DialoguePart
	{
		actor: "TRX" ; Trunks
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_21_TRX" ; The future... Protect it all!
		i8: 1
	}

	DialoguePart
	{
		actor: "TRX" ; Trunks
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_22_TRX" ; ...
		i8: 1
	}

}

