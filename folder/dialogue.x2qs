Dialogue Dialogue0
{
	i28: 0

	DialoguePart
	{
		actor: "TOK" ; Kaiohshin do Tempo
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_00_TOK" ; You both can use that new power too...?
		i8: 1
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_01_XBM" ; It's all thanks to Goku. I see now... This power is truly something else.
		i8: 0
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_02_XBM" ; Now... it all comes down to how we use it.
		i8: 0
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_03_XBM" ; That crystal on its chest is its weakness—we know that for sure. But if we let up for even a moment, the crystal regenerates.
		i8: 0
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_04_XBM" ; We need to cut off its flow of energy somehow...
		i8: 0
	}

}

Dialogue Dialogue1
{
	i28: 0

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_05_XBM" ; What? We should use this blade?
		i8: 0
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_06_XBM" ; Oh! Haha, that's a fantastic idea! Impressive as always, partner!
		i8: 0
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_07_XBM" ; This weapon was made to redirect energy. If we're smart about how we use it, then maybe—
		i8: 0
	}

	DialoguePart
	{
		actor: "TOK" ; Kaiohshin do Tempo
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_08_TOK" ; Yes, with this, we could... Huh?
		i8: 1
	}

}

