Dialogue Dialogue7
{
	i28: 0

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_04_XBM" ; We can't hold a candle to that thing with only the power Goku left us.
		i8: 0
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_05_XBM" ; We need to boost this power's potency somehow...
		i8: 0
	}

	DialoguePart
	{
		actor: "TRX" ; Trunks
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_06_TRX" ; Boost it? But how?
		i8: 1
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_07_XBM" ; The answer is Goku... His power runs opposite to that of the creature!
		i8: 0
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_08_XBM" ; And the crystals are able to use malicious desires as a medium to boost their power...
		i8: 0
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_01_09_XBM" ; Assuming Goku works the other way...
		i8: 0
	}

}

