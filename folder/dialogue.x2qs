Dialogue Dialogue14
{
	i28: 0

	DialoguePart
	{
		actor: "TOK" ; Kaiohshin do Tempo
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_09_TOK" ; I'm sorry. I think our connection's been cut off.
		i8: 1
	}

	DialoguePart
	{
		actor: "TOK" ; Kaiohshin do Tempo
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_10_TOK" ; Everything around Conton City is starting to fade away.
		i8: 1
	}

	DialoguePart
	{
		actor: "XBM" ; Fu
		costume: -1
		transformation: -1

		text_audio: "CAP_BT37_07_00_11_XBM" ; We don't have much time! We have to hustle!
		i8: 0
	}

}

