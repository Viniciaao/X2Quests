Dialogue Dialogue0
{
	i28: 0

	DialoguePart
	{
		actor: "EIB" ; Broly (Contido)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_00_0_EIB" ; Take over every planet and control the universe... That was my father's command.　
		i8: 0
	}

	DialoguePart
	{
		actor: "EIB" ; Broly (Contido)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_00_1_EIB" ; If you served my father, then make yourself useful.
		i8: 0
	}

	DialoguePart
	{
		actor: "EIB" ; Broly (Contido)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_00_2_EIB" ; We're going.
		i8: 0
	}

}

Dialogue Dialogue1
{
	i28: 0

	DialoguePart
	{
		actor: "SB2" ; Super Baby 2
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_01_0_SB2" ; This energy... It's Saiyan energy. You there! What do you want?
		i8: 0
	}

	DialoguePart
	{
		actor: "EIB" ; Broly (Contido)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_01_1_EIB" ; We're here for your planet.
		i8: 0
	}

	DialoguePart
	{
		actor: "SB2" ; Super Baby 2
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_01_2_SB2" ; You're going to steal this planet?! Ha ha ha ha! That's rich coming from a monkey like you!
		i8: 0
	}

	DialoguePart
	{
		actor: "SB2" ; Super Baby 2
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_01_3_SB2" ; But enough nonsense. I will be stealing from YOU, Saiyan!
		i8: 0
	}

}

Dialogue Dialogue3
{
	i28: 0

	DialoguePart
	{
		actor: "SB2" ; Super Baby 2
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_02_0_SB2" ; Ngh... This power is unbelievable...
		i8: 0
	}

	DialoguePart
	{
		actor: "SB2" ; Super Baby 2
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_02_1_SB2" ; Bwa ha ha ha! This power will be most useful for my master plan!
		i8: 0
	}

	DialoguePart
	{
		actor: "EIB" ; Broly (Contido)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_02_2_EIB" ; You said you'd steal something, didn't you?
		i8: 0
	}

	DialoguePart
	{
		actor: "SB2" ; Super Baby 2
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_02_3_SB2" ; I did! And I will! That powerful body of yours is MINE!
		i8: 0
	}

}

Dialogue Dialogue4
{
	i28: 0

	DialoguePart
	{
		actor: "SB2" ; Super Baby 2
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_03_0_SB2" ; GAAAAAGH!
		i8: 0
	}

	DialoguePart
	{
		actor: "SB2" ; Super Baby 2
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_03_1_SB2" ; I-I was bested... by a lowly Saiyan?!
		i8: 0
	}

	DialoguePart
	{
		actor: "EIB" ; Broly (Contido)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_03_2_EIB" ; We've wasted enough time here. That fool is no longer in our way. To the next planet.
		i8: 0
	}

	DialoguePart
	{
		actor: "SB2" ; Super Baby 2
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_03_3_SB2" ; This... This isn't over, you filthy Saiyan! You will know the wrath of the Tuffles!
		i8: 0
	}

}

Dialogue Dialogue5
{
	i28: 0

	DialoguePart
	{
		actor: "OBB" ; Baby (Macaco Gigante)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_04_0_OBB" ; Prepare yourself, puny monkey!
		i8: 0
	}

	DialoguePart
	{
		actor: "EIB" ; Broly (Contido)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_04_1_EIB" ; You should've died when you had the chance...
		i8: 0
	}

	DialoguePart
	{
		actor: "OBB" ; Baby (Macaco Gigante)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_04_2_OBB" ; I... the Tuffles... will rule over the entire universe!
		i8: 0
	}

	DialoguePart
	{
		actor: "OBB" ; Baby (Macaco Gigante)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_04_3_OBB" ; I will not fall to Saiyan scum! This ends here and now!
		i8: 0
	}

	DialoguePart
	{
		actor: "EIB" ; Broly (Contido)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_04_4_EIB" ; Stubborn... You still want to fight? You should've just accepted death.
		i8: 0
	}

}

Dialogue Dialogue6
{
	i28: 0

	DialoguePart
	{
		actor: "OBB" ; Baby (Macaco Gigante)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_05_0_OBB" ; C-Curse you, Saiyan...!
		i8: 0
	}

	DialoguePart
	{
		actor: "OBB" ; Baby (Macaco Gigante)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_05_1_OBB" ; I've changed my mind! I don't want your body! I want you DEAD! I will kill you!
		i8: 0
	}

	DialoguePart
	{
		actor: "EIB" ; Broly (Contido)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_05_2_EIB" ; Are you finished talking? Hurry up and show me your power.
		i8: 0
	}

	DialoguePart
	{
		actor: "OBB" ; Baby (Macaco Gigante)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_05_3_OBB" ; Y-You… you mock me?!
		i8: 0
	}

}

Dialogue Dialogue7
{
	i28: 0

	DialoguePart
	{
		actor: "OBB" ; Baby (Macaco Gigante)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_06_0_OBB" ; H-How?! You're not even a Super Saiyan! You filthy monkey! Damn you! Damn you!
		i8: 0
	}

	DialoguePart
	{
		actor: "OBB" ; Baby (Macaco Gigante)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_06_1_OBB" ; Y-You will know the wrath of the Tuffles! Someday... Someday Saiyans will perish!
		i8: 0
	}

	DialoguePart
	{
		actor: "EIB" ; Broly (Contido)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_06_2_EIB" ; I'm not interested in your wrath. Just die already...
		i8: 0
	}

	DialoguePart
	{
		actor: "EIB" ; Broly (Contido)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_06_3_EIB" ; Off to the next planet. I will make sure the assault is quick.
		i8: 0
	}

}

