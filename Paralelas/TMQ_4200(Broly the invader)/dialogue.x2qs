	{
		actor: "FRZ" ; Freeza (Forma Nº1)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_08_3_FRZ" ; Ready yourselves, Zarbon! Dodoria! They will learn to fear us and our power!
		i8: 0
	}

}

