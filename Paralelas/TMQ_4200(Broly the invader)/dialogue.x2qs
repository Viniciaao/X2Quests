		i8: 0
	}

	DialoguePart
	{
		actor: "FRZ" ; Freeza (Forma Nº1)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_08_2_FRZ" ; Heh heh... My, you're confident. Seems the feral dog needs to be put down.
		i8: 0
	}

