Dialogue Dialogue9
{
	i28: 0

	DialoguePart
	{
		actor: "FRZ" ; Freeza (Forma Nº1)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4200_08_0_FRZ" ; You... are a Saiyan, aren't you? So there are still more of you, then...
