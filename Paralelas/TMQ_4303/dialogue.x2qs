Dialogue Dialogue0
{
	i28: 0

	DialoguePart
	{
		actor: "JRN" ; Jiren
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_00_0_JRN" ; I take it you will be the one assisting me in this mission. Very well then. Your skill and reputation precede you.
		i8: 0
	}

	DialoguePart
	{
		actor: "JRN" ; Jiren
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_00_1_JRN" ; But I expect you to be on your guard at all times, even just on patrol.
		i8: 0
	}

}

Dialogue Dialogue1
{
	i28: 0

	DialoguePart
	{
		actor: "VGT" ; Vegeta
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_01_0_VGT" ; Hold it, Jiren!
		i8: 0
	}

	DialoguePart
	{
		actor: "JRN" ; Jiren
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_01_1_JRN" ; You're from Universe 7... What do you want?
		i8: 0
	}

	DialoguePart
	{
		actor: "VGT" ; Vegeta
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_01_2_VGT" ; I demand you show me how that uncanny power you used during the Tournament of Power works.
		i8: 0
	}

	DialoguePart
	{
		actor: "VGT" ; Vegeta
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_01_3_VGT" ; If I can defeat you and learn its secrets, I'll become stronger than ever!
		i8: 0
	}

	DialoguePart
	{
		actor: "JRN" ; Jiren
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_01_4_JRN" ; You came all this way just for that? Fine, but if you bring ANY danger to Universe 11, you will be punished.
		i8: 0
	}

	DialoguePart
	{
		actor: "JRN" ; Jiren
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_01_5_JRN" ; I discovered an intruder while on patrol who needs to be swiftly dealt with. I'll be depending on you for assistance.
		i8: 0
	}

}

Dialogue Dialogue2
{
	i28: 0

	DialoguePart
	{
		actor: "VGT" ; Vegeta
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_02_0_VGT" ; Jiren... Your power should be quite comparable to my own.
		i8: 0
	}

	DialoguePart
	{
		actor: "VGT" ; Vegeta
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_02_1_VGT" ; If anything, the difference lies in how masterfully you wield it.　
		i8: 0
	}

	DialoguePart
	{
		actor: "VGT" ; Vegeta
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_02_2_VGT" ; But I'm not going to just sit back and covet your skill. I'll make it my own!
		i8: 0
	}

}

Dialogue Dialogue3
{
	i28: 0

	DialoguePart
	{
		actor: "JRN" ; Jiren
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_03_0_JRN" ; You seem quite exhausted. Have you already learned how to wield the power you seek?
		i8: 0
	}

	DialoguePart
	{
		actor: "VGT" ; Vegeta
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_03_1_VGT" ; Kgh! You haven't seen anything from me yet!
		i8: 0
	}

	DialoguePart
	{
		actor: "VGT" ; Vegeta
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_03_2_VGT" ; HaaaaaaaAAAAH!
		i8: 0
	}

}

Dialogue Dialogue4
{
	i28: 0

	DialoguePart
	{
		actor: "JRN" ; Jiren
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_04_0_JRN" ; I see your power level has spiked. However, this alone will change nothing.　
		i8: 0
	}

	DialoguePart
	{
		actor: "VGT" ; Vegeta
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_04_1_VGT" ; Keep spouting your high-and-mighty drivel! Your bravado won't last for long!
		i8: 0
	}

}

Dialogue Dialogue5
{
	i28: 0

	DialoguePart
	{
		actor: "VGT" ; Vegeta
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_05_0_VGT" ; H-How's this even possible?!
		i8: 0
	}

	DialoguePart
	{
		actor: "VGT" ; Vegeta
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_05_1_VGT" ; Well, I'm not through yet! Watch THIS! Haaaaaa!
		i8: 0
	}

}

Dialogue Dialogue6
{
	i28: 0

	DialoguePart
	{
		actor: "JRN" ; Jiren
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_06_0_JRN" ; A waste of energy. That transformation was incomparable to my strength. Or have you forgotten already?
		i8: 0
	}

	DialoguePart
	{
		actor: "GVG" ; Vegeta SSGSS
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_06_1_GVG" ; Hmph! You'd be a fool to judge on appearance alone! I'm not the same warrior I was back then!
		i8: 0
	}

}

Dialogue Dialogue7
{
	i28: 0

	DialoguePart
	{
		actor: "GVG" ; Vegeta SSGSS
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_07_0_GVG" ; Now I see... Of course.
		i8: 0
	}

	DialoguePart
	{
		actor: "GVG" ; Vegeta SSGSS
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_07_1_GVG" ; Not a drop of your power is wasted. You focus it all on the precise moment you need it.
		i8: 0
	}

	DialoguePart
	{
		actor: "GVG" ; Vegeta SSGSS
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_07_2_GVG" ; I won't reach your level if I'm only fighting at full power all the time.
		i8: 0
	}

	DialoguePart
	{
		actor: "GVG" ; Vegeta SSGSS
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_07_3_GVG" ; Alright... Then how about this?! HaaaAAAH!
		i8: 0
	}

}

Dialogue Dialogue8
{
	i28: 0

	DialoguePart
	{
		actor: "JRN" ; Jiren
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_08_0_JRN" ; A more efficient form, from what I can determine... I expect you wish to test it on me?
		i8: 0
	}

	DialoguePart
	{
		actor: "NI2" ; Vegeta (Deus Super Saiyajin)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_08_1_NI2" ; Yes, this is the perfect opportunity. Jiren, you will help me evolve further.
		i8: 0
	}

}

