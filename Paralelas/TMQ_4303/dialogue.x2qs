Dialogue Dialogue20
{
	i28: 0

	DialoguePart
	{
		actor: "NI1" ; Vegeta SSGSS (Evoluído)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_19_0_NI1" ; Kakarot?! The hell are you doing here?
		i8: 0
	}

	DialoguePart
	{
		actor: "GGK" ; Goku SSGSS - Gi 1 da Tartaruga
		costume: 2
		transformation: -1

		text_audio: "CAQ_4303_19_1_GGK" ; Well, I felt all these crazy waves of energy clashing, so I couldn't help but fly over and check it out!
		i8: 0
	}

	DialoguePart
	{
		actor: "GGK" ; Goku SSGSS - Gi 1 da Tartaruga
		costume: 2
		transformation: -1

		text_audio: "CAQ_4303_19_2_GGK" ; Jiren... you don't mind fighting me again, do ya? C'mon, whaddya say?
		i8: 0
	}

	DialoguePart
	{
		actor: "NI1" ; Vegeta SSGSS (Evoluído)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_19_3_NI1" ; Hey, I didn't give you permission to interrupt! Why do you people keep on butting in?!
		i8: 0
	}

	DialoguePart
	{
		actor: "GGK" ; Goku SSGSS - Gi 1 da Tartaruga
		costume: 2
		transformation: -1

		text_audio: "CAQ_4303_19_4_GGK" ; Sorry, Vegeta! I'll let you have a turn later! Don't worry about it!
		i8: 0
	}

}

Dialogue Dialogue21
{
	i28: 0

	DialoguePart
	{
		actor: "GGK" ; Goku SSGSS - Gi 1 da Tartaruga
		costume: 2
		transformation: -1

		text_audio: "CAQ_4303_20_0_GGK" ; Whew, Jiren's still a tough cookie! I'm gettin' excited all over again!
		i8: 0
	}

	DialoguePart
	{
		actor: "NI1" ; Vegeta SSGSS (Evoluído)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_20_1_NI1" ; Hmph... Huh? Oh, Bulma's calling... What?!
		i8: 0
	}

	DialoguePart
	{
		actor: "NI1" ; Vegeta SSGSS (Evoluído)
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_20_2_NI1" ; You want me to come home NOW?! I'm busy—hey!
		i8: 0
	}

}

Dialogue Dialogue22
{
	i28: 0

	DialoguePart
	{
		actor: "GGK" ; Goku SSGSS - Gi 1 da Tartaruga
		costume: 2
		transformation: -1

		text_audio: "CAQ_4303_21_0_GGK" ; Oww! Man, that hurts! Agghh, I was so close to winning that time too! Wha... huh? Vegeta, are you headin' home already?
		i8: 0
	}

	DialoguePart
	{
		actor: "VGT" ; Vegeta - Traje de Batalha 8
		costume: 8
		transformation: -1

		text_audio: "CAQ_4303_21_1_VGT" ; Yes, Bulma gave me a call while you were fooling around. Dammit! That woman has the worst timing...
		i8: 0
	}

	DialoguePart
	{
		actor: "VGT" ; Vegeta - Traje de Batalha 8
		costume: 8
		transformation: -1

		text_audio: "CAQ_4303_21_2_VGT" ; At the very least, I've learned the secrets of your power. The next time we fight, I WILL surpass you... Jiren!
		i8: 0
	}

	DialoguePart
	{
		actor: "JRN" ; Jiren
		costume: -1
		transformation: -1

		text_audio: "CAQ_4303_21_3_JRN" ; Your fighting spirit is admirable. I shall be waiting for when you challenge me next... and I will be prepared.
		i8: 0
	}

}

