TextEntry TMQ_JUN_01_0
{
	en: "ONE BILLION JUNINS"
	pt: "1 Bilião de Junins"
	es: "¡MIL MILLONES DE JUNINS!"
}

TextEntry TMQ_JUN_01_1
{
	en: "-Defeat all 76 Junins\n-Defeat the Junin of the Future"
	pt: "-Derrote os 76 Junins\n-Derrote o Junin do Futuro"
	es: "-Derrota a los 76 Junins\n-Derrota al Junin del Futuro"
}

TextEntry TMQ_JUN_01_2
{
	en: "-All team HP depleted\n-Time expires"
	pt: "-Vida do time esgotada\n-Tempo esgotado"
	es: "-Salud del equipo agotada\n-Se acaba el tiempo"
}

TextEntry TMQ_JUN_01_3
{
	en: "Seventy-six Junins are flooding the Twisted Timespace. They keep coming. Just keep swinging."
	pt: "Setenta e seis Junins estão invadindo o Espaço-tempo Distorcido. Eles não param de aparecer. Continue batendo."
	es: "Setenta y seis Junins están invadiendo el Espacio-tiempo Distorsionado. No paran de aparecer. Sigue golpeando."
}

TextEntry TMQ_JUN_01_4
{
	en: "-Defeat the Junin of the Future"
	pt: "-Derrote o Junin do Futuro"
	es: "-Derrota al Junin del Futuro"
}

TextEntry TMQ_JUN_01_5
{
	en: "-Clear in under 15 minutes"
	pt: "-Zere em menos de 15 minutos"
	es: "-Termínala en menos de 15 minutos"
}

