; ===========================================================================
;  TMQ_JUS_01 - script vigia
;
;  Fecha a janela do bonus: se o relogio passar de 600s (10 minutos) a flag
;  FlagFast cai e o State 4 termina a missao sem a parte extra.
;  As flags sao compartilhadas com o script.x2qs (declaradas la).
; ===========================================================================

Script
{
	State 0
	{
		Event -1
		{
			Condition Never
		}

		Event 0
		{
			Condition Always

			Action GotoState(1)
		}
	}

	State 1
	{
		Event -1
		{
			Condition Never
		}

		Event 0
		{
			Condition TimePassed(>=, 600.0) ; 10 minutos

			Action SetFlag(FlagFast, false)
		}
	}
}
