; ===========================================================================
;  TMQ_JUS_01 - falas.
;
;  REGRA: o Juse NUNCA fala. As unicas falas dele sao "....." e ".......".
;  REGRA: o jogador NUNCA fala. Nao existe DialoguePart com o actor do player.
;  voice: "" = legenda sem audio dublado.
;  actor: usa o ENTRY_NAME do mod (JUS/JUE/...) garantido pelos X2mMod do
;  quest.x2qs - o retrato so aparece com o mod do personagem instalado.
;
;  Cada conversa inteira fica em UM bloco Dialogue com varios DialoguePart,
;  como faz o vanilla (TMQ_4601 tem blocos de ate 9 partes). PlayDialogue
;  dispara a cadeia toda e DialogueFinish so vale depois da ultima parte.
; ===========================================================================

TextAudioEntry TxtDlgJunin1
{
	en: "It wasn't me, man, I swear."
	pt: "Não fui em cara, te juro."
	es: "No fui yo, te lo juro."
	voice: ""
}

TextAudioEntry TxtDlgJuninEmo1
{
	en: "**Saibaman sounds**"
	pt: "**Sons de Saibamen**"
	es: "**Sonidos de Saibaman**"
	voice: ""
}

TextAudioEntry TxtDlgJuse1
{
	en: "....."
	pt: "....."
	es: "....."
	voice: ""
}

TextAudioEntry TxtDlgYone1
{
	en: "We didn't steal it. It was a transfer of alcoholic assets."
	pt: "A gente não roubou. Foi uma transferência de patrimônio etílico."
	es: "No la robamos. Fue una transferencia de patrimonio etílico."
	voice: ""
}

TextAudioEntry TxtDlgYasha1
{
	en: "Relax. The beer is long gone. All that's left is the smell."
	pt: "Relaxa. A beer já era. O que sobrou foi o cheiro."
	es: "Tranquilo. La cerveza ya fue. Lo que quedó es el olor."
	voice: ""
}

TextAudioEntry TxtDlgEzra1
{
	en: "AAAAAAAAAAAAAH!"
	pt: "AAAAAAAAAAAAAH!"
	es: "AAAAAAAAAAAAAH!"
	voice: ""
}

TextAudioEntry TxtDlgRay1
{
	en: "The whole timeline drank from that bottle. There's not a sip left for anyone."
	pt: "A linha do tempo inteira bebeu dessa garrafa. Não sobrou gole pra ninguém."
	es: "Toda la línea temporal bebió de esa botella. No quedó ni un trago para nadie."
	voice: ""
}

TextAudioEntry TxtDlgJuf1
{
	en: "In my future that beer was never returned. And I came to make sure it stays that way."
	pt: "No meu futuro a beer nunca foi devolvida. E eu vim garantir que continue assim."
	es: "En mi futuro esa cerveza nunca fue devuelta. Y vine a asegurar que siga así."
	voice: ""
}

TextAudioEntry TxtDlgJuse2
{
	en: "....."
	pt: "....."
	es: "....."
	voice: ""
}

TextAudioEntry TxtDlgDan1
{
	en: "Evil Majin drank it. Evil Majin liked it. Evil Majin is NOT giving it back."
	pt: "Majin Mau bebeu. Majin Mau gostou. Majin Mau NÃO devolve."
	es: "Majin Malvado la bebió. Majin Malvado le gustó. Majin Malvado NO la devuelve."
	voice: ""
}

TextAudioEntry TxtDlgBctIntro
{
	en: "Juse, calm down! Nobody knows where that thing is."
	pt: "Juse, se acalme! Ninguém sabe onde está isso aí."
	es: "¡Juse, cálmate! Nadie sabe dónde está eso."
	voice: ""
}

TextAudioEntry TxtDlgJuse3
{
	en: "....."
	pt: "....."
	es: "....."
	voice: ""
}

TextAudioEntry TxtDlgZem1
{
	en: "Forget it, he won't listen."
	pt: "Esquece, ele não dá ouvidos."
	es: "Olvídalo, no escucha a nadie."
	voice: ""
}

TextAudioEntry TxtDlgJuseFim
{
	en: "....."
	pt: "....."
	es: "....."
	voice: ""
}

TextAudioEntry TxtDlgJuseBonus
{
	en: "......."
	pt: "......."
	es: "......."
	voice: ""
}

TextAudioEntry TxtDlgVini1
{
	en: "Looks like you're in trouble..."
	pt: "Parece que você está em problemas..."
	es: "Parece que estás en problemas..."
	voice: ""
}

TextAudioEntry TxtDlgVjr1
{
	en: "Stand back, my dad and I will handle this"
	pt: "Pra trás, meu pai e eu vamos cuidar disso"
	es: "Atrás, mi papá y yo nos encargamos de esto"
	voice: ""
}

TextAudioEntry TxtDlgJuse4
{
	en: "...."
	pt: "...."
	es: "...."
	voice: ""
}

TextAudioEntry TxtDlgVjr2
{
	en: "Dad, he keeps staring at me with those deep eyes... it gives me chills"
	pt: "Pai, ele ta me olhando com aqueles olhos profundos... me da arrepios"
	es: "Papá, me está mirando con esos ojos profundos... me da escalofríos"
	voice: ""
}

TextAudioEntry TxtDlgLui1
{
	en: "Vini! N-no!"
	pt: "Vini!, n-não!"
	es: "¡Vini!, ¡n-no!"
	voice: ""
}

TextAudioEntry TxtDlgShinya1
{
	en: "Cut the drama, idiot! They're alive. I think..."
	pt: "Sem drama idiota!, eles estão vivos. eu acho..."
	es: "¡Sin drama, idiota!, están vivos. Eso creo..."
	voice: ""
}

TextAudioEntry TxtDlgJuse5
{
	en: "....."
	pt: "....."
	es: "....."
	voice: ""
}

TextAudioEntry TxtDlgBctTaunt1
{
	en: "I told you, Juse. You should have listened to me.."
	pt: "Eu disse Juse, você deveria ter me escutado.."
	es: "Te lo dije, Juse. Deberías haberme escuchado.."
	voice: ""
}

TextAudioEntry TxtDlgBctTaunt2
{
	en: "Now look at you... how humiliating."
	pt: "Agora olha pro 'cê... que humilhante."
	es: "Ahora mírate... qué humillante."
	voice: ""
}

TextAudioEntry TxtDlgBctTaunt3
{
	en: "But you're still coming in to work tomorrow, right?"
	pt: "Mas você vem trabalhar amanhã, né?"
	es: "Pero mañana vienes a trabajar, ¿no?"
	voice: ""
}

