TextEntry TMQ_JUS_01_0
{
	en: "GIVE BACK MY BEER!"
	pt: "DEVOLVA MINHA BEER!"
	es: "!DEVUELVE MI CERVEZA!"
}

TextEntry TMQ_JUS_01_1
{
	en: "-Defeat every beer thief"
	pt: "-Derrote todos os ladroes de beer"
	es: "-Derrota a todos los ladrones de cerveza"
}

TextEntry TMQ_JUS_01_2
{
	en: "-All team HP depleted\n-Time expires"
	pt: "-A vida do time acabou\n-O tempo acabou"
	es: "-Se agoto la vida del equipo\n-Se acabo el tiempo"
}

TextEntry TMQ_JUS_01_3
{
	en: "Someone stole Juse's last beer. He won't say a single word, he just stares. Chase the thieves across three districts, get the bottle back and pray nobody sees Juse angry."
	pt: "Roubaram a ultima beer do Juse. Ele nao diz uma palavra, so olha. Persiga os ladroes por tres distritos, recupere a garrafa e reze pra ninguem ver o Juse com raiva."
	es: "Alguien robo la ultima cerveza de Juse. El no dice una palabra, solo mira. Persigue a los ladrones por tres distritos, recupera la botella y reza para que nadie vea a Juse enojado."
}

TextEntry TMQ_JUS_01_4
{
	en: "-Clear in under 10 minutes"
	pt: "-Termine em menos de 10 minutos"
	es: "-Terminalo en menos de 10 minutos"
}

TextEntry TMQ_JUS_01_5
{
	en: "-Survive Juse's revenge"
	pt: "-Sobreviva a vinganca do Juse"
	es: "-Sobrevive a la venganza de Juse"
}

