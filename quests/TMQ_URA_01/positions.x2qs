; ===========================================================================
;  TMQ_URA_01 - posicoes iniciais
;  Os inimigos NAO tem CharPosition de proposito: eles entram em cena com
;  CharaSpawn/CharaSpawn2/CharaSpawn3, que usam os pontos TRESPASS_N do
;  estagio (ver script.x2qs).
;
;  "RBQ_4000_POS_xx" sao pontos que ja existem no mapa do estagio BFrrg
;  (Red Ribbon Army Yard) - o mesmo conjunto usado pelo raid vanilla
;  RBQ_4000, entao nao dependem de DLC.
; ===========================================================================

CharPosition PlayerPosition
{
	char: Player ; Player
	stage: "BFrrg" ; Red Ribbon Army (Yard)
	position: "RBQ_4000_POS_00"
	type: 3
	i40: 0
	i50: 0
}

