; ===========================================================================
;  TMQ_URA_01 - "NAO COMA O URANIO!"  /  "DON'T EAT THE URANIUM!"
;  Missao paralela customizada.
;  Todos os textos usam TextEntry / TextAudioEntry, ou seja, a missao nao
;  depende de nenhum arquivo .msg vanilla.
; ===========================================================================

TextEntry TMQ_URA_01_0
{
	en: "DON'T EAT THE URANIUM!"
	pt: "NÃO COMA O URÂNIO!"
	es: "¡NO TE COMAS EL URANIO!"
}

TextEntry TMQ_URA_01_1
{
	en: "-Defeat all the uranium inspectors"
	pt: "-Derrote todos os fiscais de urânio"
	es: "-Derrota a todos los inspectores de uranio"
}

TextEntry TMQ_URA_01_2
{
	en: "-All team HP depleted\n-Time expires"
	pt: "-A vida da equipe acabar\n-O tempo acabar"
	es: "-La vida del equipo se agota\n-Se acaba el tiempo"
}

TextEntry TMQ_URA_01_3
{
	en: "A gang of loudmouths has taken over the Red Ribbon Army Yard. They only\ntalk about two things: that you must NOT eat uranium, and the size of your...\n\"equipment\". Somebody please shut them up."
	pt: "Um bando de desocupados tomou o Pátio do Exército Red Ribbon e só sabe falar\nde duas coisas: que você NÃO deve comer urânio e do tamanho do seu...\n\"equipamento\". Alguém precisa calar a boca deles."
	es: "Una pandilla de bocazas tomó el Patio del Ejército Red Ribbon y solo habla\nde dos cosas: de que NO debes comer uranio y del tamaño de tu... \"equipo\".\nQue alguien los mande callar."
}

TextEntry TMQ_URA_01_4
{
	en: "-Clear in under 5 minutes"
	pt: "-Termine em menos de 5 minutos"
	es: "-Termínala en menos de 5 minutos"
}

TextEntry TMQ_URA_01_5
{
	en: "-Defeat the Enraged Grand Moderator"
	pt: "-Derrote o Grande Moderador Enfurecido"
	es: "-Derrota al Gran Moderador Enfurecido"
}

